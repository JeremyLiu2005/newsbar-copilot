            "segmenter.segment",
            "labeler.make_label"
          ],
          "params": []
        },
        {
          "id": "FB-6",
          "text": "黑畫面超過 30 秒 → 判定訊號中斷，這一段寫「訊號中斷」，優先於廣告判斷。",
